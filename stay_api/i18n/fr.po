#. module: stay_api
#: model:mail.template,body_html:stay_api.stay_controller_notify
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">Stay <t t-out=\"object.name\"/> has been <t t-out=\"ctx."
"get('action_description')\"/> via the web form:</p>\n"
"                <ul>\n"
"                    <li>Guest: <t t-out=\"object.partner_name\">Alexis de "
"Lattre</t></li>\n"
"                    <li>Guest Qty: <t t-out=\"object.guest_qty\">1</t></li>\n"
"                    <li>Arrival: <t t-out=\"format_date(object."
"arrival_date)\">2026-02-15</t> <t t-out=\"dict(object."
"fields_get('arrival_time', 'selection')['arrival_time']['selection'])[object."
"arrival_time]\">Afternoon</t></li>\n"
"                    <t t-if=\"object.arrival_note\">\n"
"                        <li>Arrival Note: <t t-out=\"object."
"arrival_note\">TER 15h</t></li>\n"
"                    </t>\n"
"                    <li>Departure: <t t-out=\"format_date(object."
"departure_date)\">2026-02-19</t> <t t-out=\"dict(object."
"fields_get('departure_time', 'selection')['departure_time']['selection'])"
"[object.departure_time]\">Evening</t></li>\n"
"                    <t t-if=\"object.departure_note\">\n"
"                        <li>Departure Note: <t t-out=\"object."
"departure_note\">TER 20h30</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.group_id\">\n"
"                        <li>Group: <t t-out=\"object.group_id."
"display_name\">Hôtellerie du village</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_email\">\n"
"                        <li>E-mail: <t t-out=\"object."
"controller_email\">alexis@example.fr</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_phone\">\n"
"                        <li>Phone: <t t-out=\"object.controller_phone\">+33 "
"4 78 55 66 77</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_mobile\">\n"
"                        <li>Mobile: <t t-out=\"object."
"controller_mobile\">+33 6 11 22 33 44</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_message\">\n"
"                        <li>Guest message: <t t-out=\"object."
"controller_message\">My motivation for this stay.</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_notes\">\n"
"                        <li>Other information: <t t-out=\"object."
"controller_notes\">Specific questions.</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_country_id\">\n"
"                        <li>Country: <t t-out=\"object.controller_country_id."
"name\">France</t></li>\n"
"                    </t>\n"
"                </ul>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">Le "
"séjour <t t-out=\"object.name\"/> a été réservé via le formulaire en ligne à "
"l'adresse <t t-out=\"ctx.get('action_description')\"/>:</p>\n"
"                <ul>\n"
"                    <li>Hôte : <t t-out=\"object.partner_name\">Alexis de "
"Lattre</t></li>\n"
"                    <li>Nb de personnes : <t t-out=\"object.guest_qty\">1</t>"
"</li>\n"
"                    <li>Arrivée : <t t-out=\"format_date(object.arrival_date)"
"\">15 février 2026</t>, <t t-out=\"dict(object.fields_get('arrival_time', "
"'selection')['arrival_time']['selection'])[object.arrival_time]\">dans "
"l'après-midi</t></li>\n"
"                    <t t-if=\"object.arrival_note\">\n"
"                        <li>Note d'arrivée : <t t-"
"out=\"object.arrival_note\">TER 15 h</t></li>\n"
"                    </t>\n"
"                    <li>Départ : <t t-out=\"format_date"
"(object.departure_date)\">19 février 2026</t>, <t t-out=\"dict"
"(object.fields_get('departure_time', 'selection')"
"['departure_time']['selection'])[object.departure_time]\">en soirée</t></li>"
"\n"
"                    <t t-if=\"object.departure_note\">\n"
"                        <li>Note de départ : <t t-"
"out=\"object.departure_note\">TER 20 h 30</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.group_id\">\n"
"                        <li>Groupe : <t t-"
"out=\"object.group_id.display_name\">Hôtellerie du village</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_email\">\n"
"                        <li>E-mail : <t t-out=\"object.controller_email\">"
"alexis@example.fr</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_phone\">\n"
"                        <li>Téléphone : <t t-out=\"object.controller_phone\">"
"+33 4 78 55 66 77</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_mobile\">\n"
"                        <li>Portable : <t t-out=\"object.controller_mobile\">"
"+33 6 11 22 33 44</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_message\">\n"
"                        <li>Message de l'hôte : <t t-"
"out=\"object.controller_message\">Ma motivation pour ce séjour.</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_notes\">\n"
"                        <li>Autres informations : <t t-"
"out=\"object.controller_notes\">Questions spécifiques.</t></li>\n"
"                    </t>\n"
"                    <t t-if=\"object.controller_country_id\">\n"
"                        <li>Pays : <t t-"
"out=\"object.controller_country_id.name\">France</t></li>\n"
"                    </t>\n"
"                </ul>\n"
"            </div>\n"
"        "

