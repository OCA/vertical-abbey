<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stay.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="stay" position="inside">
                <block id="stay_api" title="Stay API">
                    <setting id="stay_controller_company">
                        <field name="stay_controller_company_id" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
