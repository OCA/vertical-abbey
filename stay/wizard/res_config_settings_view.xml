<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    name="stay"
                    data-string="Stays"
                    string="Stays"
                    data-key="stay"
                    groups="stay.group_stay_manager"
                >
                    <block title="Stays" id="stays">
                        <setting
                            id="stay_room_transition"
                            help="One Empty Period: when a guest leaves the room in the morning, the next guest can have the room in the afternoon the same day, but not in the morning. Immediate: the next guest can start his stay in the morning. The same applies for afternoon vs evening. Night: when a guest leaves the room in the afternoon, the next guest can arrive in the morning: he will have the room for the night."
                        >
                            <field name="stay_room_transition" widget="radio" />
                        </setting>
                        <setting id="stay_default_refectory">
                            <field name="stay_default_refectory_id" />
                        </setting>
                        <setting
                            id="stay_notify_users"
                            string="Users Notified by E-mail for Stays without Group"
                        >
                            <field
                                name="stay_notify_user_ids"
                                widget="many2many_tags"
                            />
                        </setting>
                        <setting id="stay_breakfast">
                            <field name="group_stay_breakfast" />
                        </setting>
                        <setting id="stay_picnic">
                            <field name="group_stay_picnic" />
                        </setting>
                        <setting id="stay_group">
                            <field name="group_stay_group" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="stay_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'stay', 'bin_size': False}</field>
    </record>

    <menuitem
        id="stay_settings_menu"
        parent="stay_configuration"
        sequence="10"
        action="stay_settings_action"
        groups="base.group_system"
    />
</odoo>
