<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">donation_stay.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stay.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="stay" position="inside">
                <block title="Donation for a Stay" id="donation_stay">
                    <setting id="donation_stay_product_id">
                        <field
                            name="donation_stay_product_id"
                            context="{'default_type': 'service', 'default_donation_type': 'donation', 'default_purchase_ok': False}"
                        />
                    </setting>
                    <setting id="donation_stay_campaign_id">
                        <field name="donation_stay_campaign_id" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
